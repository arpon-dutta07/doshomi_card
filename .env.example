# Copy this file to .env.local and fill it in. Never commit .env.local.

# Supabase → Project Settings → API Keys / Data API
SUPABASE_URL=https://your-project.supabase.co
# The secret key (sb_secret_...) or the older service_role key. Server only, never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Any long random string. Vercel sends it to /api/cron, which keeps the free project awake and clears old photos.
CRON_SECRET=

# Where the site lives (used for absolute links in WhatsApp previews)
NEXT_PUBLIC_SITE_URL=http://localhost:5200
